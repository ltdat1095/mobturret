# =============================================================================
# MobTurret server — local dev config
# =============================================================================
# Copy this file to `.env` and adjust values as needed.
# `.env` is gitignored (see root .gitignore section E).
# All values can also be overridden by environment variables of the same name.

# --- HTTP server ---
# 8182 to avoid collisions with other dev servers on 8080.
# Must match `kApiBaseUrl` in gun_bot_mobile/lib/core/config.dart
# (or be passed via --dart-define=API_BASE_URL=...).
PORT=8182
ENV=development

# --- Logging ---
# LOG_FORMAT: console (dev) | json (prod)
LOG_FORMAT=console
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# --- AWS / DynamoDB ---
# DYNAMODB_ENDPOINT is the local DynamoDB Local container.
# In prod, leave this empty to use the real AWS endpoint.
DYNAMODB_ENDPOINT=http://localhost:8181
AWS_REGION=ap-southeast-1
# Dummy creds for DynamoDB Local (the engine ignores these, but the SDK
# requires a credential provider).
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# --- Tables ---
USERS_TABLE=Users

# --- JWT ---
# Secret MUST be >= 32 bytes for HS256.
# Generate a real one for prod: `openssl rand -hex 32`
JWT_SECRET_KEY=dev-only-change-me-must-be-at-least-32-bytes-long
JWT_ISSUER=mobturret-server
JWT_AUDIENCE=mobturret-mobile
JWT_TTL_HOURS=24
