/*
 * LPUART3 overlay for FRDM-iMX93 M33 core.
 *
 * Pure-Zephyr path: the LPUART3 node from the fork's
 * nxp_imx93_m33.dtsi (disabled by default) is enabled here, bound to
 * the mcux_lpuart driver, and routed through uart3_default pinctrl
 * (GPIO_IO14 -> LPUART3_TX, GPIO_IO15 -> LPUART3_RX). main.cpp drives
 * the bus via Zephyr's uart_poll_in / uart_poll_out against this node.
 *
 * Two-pin mode with external short (TX ↔ RX) on GPIO_14/GPIO_15 for
 * loopback bring-up.
 */

/* SPDX-License-Identifier: Apache-2.0 */
&lpuart3 {
	status = "okay";
	current-speed = <1000000>;
	pinctrl-0 = <&uart3_default>;
	pinctrl-names = "default";
};