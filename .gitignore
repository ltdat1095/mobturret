# ============================================================================
# MobTurret .gitignore
# ============================================================================
#
# Two principles:
#  1. Vendored upstream source trees are NOT in this repo. They live on
#     disk for the build to work, but git tracks only the wiring.
#  2. Generated artifacts are never committed. They're reproducible from
#     the source + build commands in each subproject's CLAUDE.md.
#
# Sections:
#   A. Vendored upstream source trees
#   B. Build outputs (per-language)
#   C. Editors / IDEs
#   D. OS noise
#   E. Secrets (NEVER commit)
# ============================================================================

# ----------------------------------------------------------------------------
# A. Vendored upstream source trees
# ----------------------------------------------------------------------------
#
# The Zephyr source tree is a registered git submodule (see
# .gitmodules) at gun_bot/m33_firmware/nxp_zephyr, pointing at
# github.com/ltdat1095/zephyr (user's fork of zephyrproject-rtos/zephyr).
# Clone it with: `git submodule update --init --recursive`.
#
# The MobTurret SDK baud-override patch is applied directly to the
# fork's modules/hal/nxp/mcux-sdk-ng/drivers/lpuart directory; see
# fork-snapshots/nxp-zephyr-fork/0001-...fork4.5.patch for the diff.

# Pre-2026-06-28 NXP downstream zephyr tree, kept as a backup during
# the migration to the user's fork. Safe to delete once the new path
# is verified on hardware.
gun_bot/m33_firmware/nxp_zephyr.bak/

# Broken external symlink left over from the upstream physical_gunbound
# repo — points outside this tree and is meaningless on a fresh clone.
gun_bot/m33_firmware/gun_controller/__repo__

# ----------------------------------------------------------------------------
# West workspace output (populated by `west update`).
#
# `nxp_zephyr` itself IS tracked as a git submodule (see .gitmodules).
# Everything else under `m33_firmware/` that is "modules/", "bootloader/",
# "tools/", or ".west/" is created by west and must NEVER be committed —
# these live in upstream zephyrproject-rtos repos.
#
#   modules/    — west pulls hal_nxp + CMSIS + lib + others here.
#                 modules/hal/nxp at c7f1b8449 carries the MobTurret
#                 1 Mbaud SDK patch.
#   bootloader/ — west pulls MCUboot here (only used by sysbuild).
#   tools/      — west pulls host-tools scripts here.
#   .west/      — west's own config dir (manifest path).
# ----------------------------------------------------------------------------
gun_bot/m33_firmware/modules/
gun_bot/m33_firmware/bootloader/
gun_bot/m33_firmware/tools/
gun_bot/m33_firmware/.west/


# ----------------------------------------------------------------------------
# B. Build outputs (per-language)
# ----------------------------------------------------------------------------

# --- C / C++ / Zephyr / MCUXpresso ---
**/debug/
**/release/
**/build/
**/install/
**/log/
**/cmake-build-*/
# Zephyr / SDK specific
**/zephyr/zephyr.elf
**/zephyr/zephyr.bin
**/zephyr/zephyr.map
**/zephyr/.config
**/zephyr/include/generated/
**/CMakeCache.txt
**/CMakeFiles/
**/cmake_install.cmake
**/Makefile
**/compile_commands.json
# Generic C/C++ object outputs
**/*.o
**/*.a
**/*.so
**/*.d

# --- ROS2 (colcon) ---
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# --- Go ---
bin/
*.exe
*.test
*.out
vendor/

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
.flutter-version
coverage/

# --- Python (used by SCServo_Linux + STServo_Python + future scripts) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
venv/
.venv/
.pytest_cache/
.mypy_cache/

# --- Node (used if/when AWS CDK / SAM tooling lands) ---
node_modules/
.npm/
.eslintcache


# ----------------------------------------------------------------------------
# C. Editors / IDEs
# ----------------------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo
*~
*.iml
.project
.classpath
.settings/

# Project-local VSCode settings are tracked — override globally per dev.


# ----------------------------------------------------------------------------
# D. OS noise
# ----------------------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ----------------------------------------------------------------------------
# E. Secrets — NEVER commit
# ----------------------------------------------------------------------------
#
# .env.example is committed (documents the schema); .env is not.
# Device certs, AWS keys, FCM tokens never go in this repo.

.env
.env.local
.env.*.local
.env.production
*.pem
*.key
*.p12
secrets/
credentials.json
service-account*.json
